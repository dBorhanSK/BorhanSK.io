# Owner access. Set a unique, long password (16+ characters recommended).
OWNER_USERNAME=owner
DASHBOARD_PASSWORD=replace-with-a-long-unique-owner-password
SECRET_KEY=generate-a-long-random-secret
WEBHOOK_TOKEN=generate-another-long-random-token

# Supabase project settings. Use the server-side service role key only here.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_SIDE_SECRET_KEY
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PROFILE_ENCRYPTION_KEY=GENERATE_A_FERNET_KEY

# Runtime
DATA_DIR=./data
REQUIRE_SUPABASE=false
TELEGRAM_WEB_URL=https://web.telegram.org/k/
BROWSER_HEADLESS=true
COOKIE_SECURE=false
PORT=10000
MIN_JOB_INTERVAL_SECONDS=60
MAX_ACTIVE_JOBS_PER_ACCOUNT=20
MAX_TOTAL_JOBS_PER_ACCOUNT=200
SESSION_SAVE_INTERVAL_SECONDS=60
SUPABASE_HEARTBEAT_INTERVAL_SECONDS=240
WAKE_WAIT_SECONDS=55
LOG_LEVEL=INFO

# Best-effort self-ping via Render's public URL. This cannot override Render lifecycle rules.
KEEPALIVE_ENABLED=true
KEEPALIVE_INTERVAL_SECONDS=240
KEEPALIVE_TIMEOUT_SECONDS=20
LOGIN_MAX_ATTEMPTS=7
LOGIN_LOCK_SECONDS=900
# Optional comma-separated host allow-list (leave empty if Render's custom host is not known).
TRUSTED_HOSTS=
