# Oracle public DNS. Replace dots in your public IPv4 with hyphens, e.g. 123-45-67-89.nip.io
API_HOST=YOUR-ORACLE-IP.nip.io
API_SCHEME=https

# Supabase: Settings -> API -> Project URL and service_role key.
# NEVER add these values to frontend files or commit .env to GitHub.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
REQUIRE_SUPABASE=true

# Generate unique values with: openssl rand -hex 32
OWNER_USERNAME=owner
DASHBOARD_PASSWORD=CHANGE-THIS-TO-A-VERY-LONG-UNIQUE-PASSWORD
SECRET_KEY=REPLACE_WITH_OPENSSL_RANDOM_HEX
WEBHOOK_TOKEN=REPLACE_WITH_ANOTHER_RANDOM_VALUE

PUBLIC_ORIGINS=https://borhansk.netlify.app
COOKIE_SECURE=true
SESSION_HOURS=12
APP_TIMEZONE=Europe/Berlin

# Each account uses a separate official Telegram Desktop profile under /data.
TELEGRAM_DATA_DIR=/data/telegram
APP_LOG_DIR=/data/logs
VNC_TOKEN_FILE=/data/vnc_tokens.txt
DESKTOP_WIDTH=1366
DESKTOP_HEIGHT=768
MAX_DESKTOP_ACCOUNTS=2

# Operational settings. Heartbeat is monitoring, not an Oracle anti-reclaim guarantee.
HEARTBEAT_INTERVAL_SECONDS=300
MIN_JOB_INTERVAL_SECONDS=60
MAX_ACTIVE_JOBS_PER_ACCOUNT=20
MAX_TOTAL_JOBS_PER_ACCOUNT=200
SCHEDULER_POLL_SECONDS=10

# Safe data retention: only old event logs and temporary upload files are pruned.
# Accounts, admins, Telegram profile data, and active/paused jobs are never auto-deleted.
EVENT_RETENTION_DAYS=30
UPLOAD_RETENTION_HOURS=48
CLEANUP_INTERVAL_SECONDS=21600
