# Dashboard access. Use a long, unique password. Never commit real secrets.
DASHBOARD_PASSWORD=change-this-to-a-long-random-password
SECRET_KEY=generate-a-long-random-secret
WEBHOOK_TOKEN=generate-another-long-random-token

# Supabase project settings. Use the server-side service role / secret key only here.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_SIDE_SECRET_KEY

# The profile folder must live on Render's persistent disk.
DATA_DIR=./data
TELEGRAM_WEB_URL=https://web.telegram.org/k/
BROWSER_HEADLESS=true
COOKIE_SECURE=false
# Public URL keepalive (Render sets RENDER_EXTERNAL_URL automatically)
KEEPALIVE_ENABLED=true
KEEPALIVE_INTERVAL_SECONDS=240
KEEPALIVE_TIMEOUT_SECONDS=15
PORT=10000
MIN_JOB_INTERVAL_SECONDS=60
LOG_LEVEL=INFO
